# ===== Copia este archivo a .env y rellena los valores =====

# Modo de autenticación: "delegated" (sin admin, recomendado) o "app" (app-only, requiere consentimiento admin)
AUTH_MODE=delegated

# ID de aplicación (cliente) de la app registrada en Entra ID
CLIENT_ID=00000000-0000-0000-0000-000000000000

# Tenant: el id de tu tenant, o 'organizations' (cuentas de trabajo) / 'common'
TENANT_ID=organizations

# --- Sólo modo delegado ---
# Refresh token obtenido con `npm run login` (una vez)
GRAPH_REFRESH_TOKEN=

# --- Sólo modo app ---
# CLIENT_SECRET=

# Token que protege el endpoint público. Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# Puerto (los hosts lo suelen fijar automáticamente)
PORT=3000
